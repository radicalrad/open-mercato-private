# Open Mercato - Production Environment Configuration
# Copy this file to .env and fill in the values

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=open_mercato
POSTGRES_PASSWORD=<GENERATE_STRONG_PASSWORD>
POSTGRES_DB=open_mercato

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Meilisearch ───────────────────────────────────────────────────────────────
MEILISEARCH_MASTER_KEY=<GENERATE_STRONG_KEY>

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=production
SESSION_SECRET=<GENERATE_64_CHAR_SECRET>
JWT_SECRET=<GENERATE_64_CHAR_SECRET>

# ── Image tag (set by CI) ────────────────────────────────────────────────────
IMAGE_TAG=latest
GHCR_ORG=radicalrad

# ── Monitoring (optional) ─────────────────────────────────────────────────────
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=open-mercato-production

# ── Deploy ────────────────────────────────────────────────────────────────────
DEPLOY_HOST=<server-ip>
DEPLOY_USER=deploy

# ── Storage (optional, for S3-compatible storage) ────────────────────────────
# STORAGE_PATH=/opt/open-mercato/data/storage
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_BUCKET=open-mercato-storage
